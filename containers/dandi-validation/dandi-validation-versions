#!/usr/bin/env python
"""Print, as JSON, the versions of the software in the dandi-validation image."""

import importlib.metadata
import json
import platform
import subprocess

#: The packages whose versions make up the image's version code (dandi/dandi-archive#2987).
VALIDATORS = ("dandi", "dandischema", "nwbinspector", "pynwb", "hdmf", "bids-validator-deno")
#: Other packages a job's results depend on.
TOOLS = ("datalad", "datalad-container", "datalad-fuse", "remfile", "con-duct", "bidsschematools")


def _command_version(command: list[str]) -> str | None:
    try:
        output = subprocess.run(command, capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    return output.splitlines()[0].strip() if output else None


def _distribution_version(name: str) -> str | None:
    try:
        return importlib.metadata.version(name)
    except importlib.metadata.PackageNotFoundError:
        return None


versions = {
    "validator_versions": {name: _distribution_version(name) for name in VALIDATORS},
    "tool_versions": {name: _distribution_version(name) for name in TOOLS},
    "python": platform.python_version(),
    "git": _command_version(["git", "--version"]),
    "git_annex": _command_version(["git", "annex", "version", "--raw"]),
    "all_distributions": dict(
        sorted(
            (distribution.metadata["Name"], distribution.version) for distribution in importlib.metadata.distributions()
        ),
    ),
}
print(json.dumps(versions, indent=2))
